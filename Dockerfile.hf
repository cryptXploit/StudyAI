FROM node:22-bookworm-slim AS build

WORKDIR /app

# Install yt-dlp as system binary (for hybrid transcript engine)
RUN apt-get update && apt-get install -y ca-certificates curl --no-install-recommends \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
RUN npm install -w backend --include-workspace-root --no-audit --no-fund

COPY backend ./backend
RUN npx tsc -p backend/tsconfig.production.json

FROM node:22-bookworm-slim AS production

# Hugging Face requires running as a non-root user (id 1000)
RUN useradd -m -u 1000 user

# Install Python (for yt-dlp), Redis, and Supervisor
RUN apt-get update && apt-get install -y ca-certificates curl python3 redis-server supervisor --no-install-recommends \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Set ownership of app directory
RUN chown -R user:user /app

# Copy package files and compiled code from build stage
COPY --chown=user:user package.json package-lock.json ./
COPY --chown=user:user backend/package.json ./backend/package.json
COPY --chown=user:user frontend/package.json ./frontend/package.json
COPY --chown=user:user --from=build /app/node_modules ./node_modules
COPY --chown=user:user --from=build /app/backend/dist ./backend/dist

# Copy supervisord configuration
COPY --chown=user:user supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Switch to non-root user for Hugging Face Spaces
USER user

# Environment variables
ENV NODE_ENV=production
ENV PORT=7860

# Expose port required by Hugging Face
EXPOSE 7860

# Start supervisor which will start both Redis and Node.js Backend
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
