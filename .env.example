# ============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in actual values for your environment.
# This template is for DEVELOPMENT. See .env for production guidance.
# ============================================================================

# ============================================================================
# NODE.JS RUNTIME & BACKEND CONFIGURATION
# ============================================================================
NODE_ENV=development
LOG_LEVEL=info
PORT=5000

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

# ============================================================================
# DATABASE & STORAGE (Supabase)
# ============================================================================
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# REDIS & MESSAGE QUEUE (BullMQ)
# ============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# AUTHENTICATION & SECURITY (Backend Only)
# ============================================================================
BACKEND_API_KEY=

# ============================================================================
# AI & ML SERVICES (Backend Only)
# ============================================================================
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ATOMESUS_API_KEY=
EMBEDDING_FALLBACK_KEY=
FREE_USER_FALLBACK_KEY=
PRO_USER_FALLBACK_KEY=

# ============================================================================
# EXTERNAL WEBHOOKS & INTEGRATIONS (Backend Only)
# ============================================================================
N8N_WEBHOOK_SUMMARY_URL=

# ============================================================================
# FRONTEND-SPECIFIC (Public - Safe Variables)
# ============================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ============================================================================
# FEATURE FLAGS & SETTINGS
# ============================================================================
SUMMARY_PARALLEL_LIMIT=50
DEBUG=false

# Optional model fallback defaults. Active admin configuration takes precedence.
DEFAULT_GEMINI_GENERAL_MODEL=
DEFAULT_GEMINI_COMPLEX_MODEL=
DEFAULT_GEMINI_EMBEDDING_MODEL=
DEFAULT_GROQ_GENERAL_MODEL=
DEFAULT_GROQ_COMPLEX_MODEL=

# Redis connection-string alternative (takes precedence where supported)
REDIS_URL=redis://localhost:6379

# Payments, notifications and OCR (backend-only)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
SMS_SECRET_HEADER=
GOOGLE_CLOUD_KEY_FILE=
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# Paddle browser configuration (safe only as public client configuration)
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Test-only settings. Do not enable these in a public production deployment.
E2E_ENABLED=false
E2E_API_URL=http://localhost:5000/api
E2E_FRONTEND_URL=http://localhost:3000
