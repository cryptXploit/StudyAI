# SUPABASE CONFIGURATION
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# GOOGLE OAUTH (Optional - if enabling Google sign-in)
# Configure at https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# BACKEND API (Optional - for chat/upload endpoints)
NEXT_PUBLIC_API_URL=http://localhost:5000


# Use sandbox with a Paddle sandbox client token locally. Set both values to
# production/live only in the production deployment environment.
NEXT_PUBLIC_PADDLE_ENV="sandbox"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_..."
