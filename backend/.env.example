# ============================================================================
# PRODUCTION-READY ENVIRONMENT CONFIGURATION
# ============================================================================
# 
# SECURITY NOTICE: This file contains sensitive information.
# - Never commit actual secrets to version control
# - Use .env.local for development (add to .gitignore)
# - Use environment variable secrets in production (GitHub Secrets, K8s Secrets, etc.)
# - Always validate and sanitize all credentials before deployment
# 
# TEMPLATE: Copy this file to .env and replace with actual values
# ============================================================================

# ============================================================================
# Node.js Runtime
# ============================================================================
NODE_ENV=production
LOG_LEVEL=info
PORT=5000

# ============================================================================
# Frontend Configuration (CORS & Redirects)
# ============================================================================
# Must match your deployed frontend origin exactly
# For development: http://localhost:3000
# For production: https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ============================================================================
# Database & Storage (Supabase)
# ============================================================================
# Get from: https://supabase.com/dashboard/project/_/settings/api
#
# SUPABASE_URL: Your project URL (public, safe to expose in client)
# SUPABASE_SERVICE_ROLE_KEY: Server-side secret key (KEEP SECURE, never expose to client)
#   - Has full access to database without RLS policies
#   - Required for: database migrations, admin operations
#   - DO NOT send to frontend
#
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# Redis & Message Queue (BullMQ)
# ============================================================================
# Used for: background jobs, caching, rate limiting
# Options:
#   - Local development: redis://localhost:6379
#   - Docker: redis://redis:6379
#   - Cloud: redis://username:password@redis.example.com:6379
#   - AWS ElastiCache: redis://your-cluster.xxxxx.cache.amazonaws.com:6379
#   - Azure Cache: redis://your-cache.redis.cache.windows.net:6379
#
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Authentication & Security
# ============================================================================
# BACKEND_API_KEY: Secret token for n8n webhooks and internal service communication
#   - Generate with: openssl rand -hex 32
#   - Share only with authorized services (n8n, automated scripts)
#   - DO NOT expose in frontend
#
BACKEND_API_KEY=your-secret-api-key-here

# ============================================================================
# AI & ML Services
# ============================================================================

# Google Gemini AI (Daily Summaries)
#   - Get key from: https://ai.google.dev/
#   - Used by: daily-summary.worker
#   - Scopes: Read Google Drive, Generate text content
#
GEMINI_API_KEY=your-gemini-api-key

# Stable fallback models. Admin-configured database models still take priority.
DEFAULT_GEMINI_GENERAL_MODEL=gemini-3.5-flash
DEFAULT_GEMINI_COMPLEX_MODEL=gemini-3.1-pro-preview
DEFAULT_GROQ_GENERAL_MODEL=openai/gpt-oss-20b
DEFAULT_GROQ_COMPLEX_MODEL=openai/gpt-oss-120b
DEFAULT_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# DeepSeek API (Alternative LLM)
#   - Get from: https://deepseek.com
#   - Optional, used for fallback LLM processing
#
DEEPSEEK_API_KEY=your-deepseek-api-key

# Google Cloud Vision (OCR)
#   - Get from: https://console.cloud.google.com/
#   - Enable Cloud Vision API
#   - Path to JSON key file (keep secure in container/K8s secret)
#   - Used by: ocr.worker
#
GOOGLE_CLOUD_KEY_FILE=/etc/secrets/google-cloud-key.json

# ============================================================================
# External Webhooks & Integrations
# ============================================================================

# n8n Notification Hub (Daily summaries, notifications)
#   - URL format: https://your-n8n-instance.com/webhook/summary
#   - Used by: daily-summary.worker.triggerN8nNotificationWebhook()
#
N8N_WEBHOOK_SUMMARY_URL=https://n8n.example.com/webhook/summary

# ============================================================================
# Feature Flags & Settings
# ============================================================================

# Parallel limit for batch processing (prevents API rate-limit)
#   - Daily summaries: how many users to process in parallel
#   - Recommended: 50 (adjust based on Gemini API tier)
#
SUMMARY_PARALLEL_LIMIT=50

# Debug mode (development only)
#   - Includes full error stack traces in responses
#   - NEVER enable in production
#
DEBUG=false

# Additional provider, payment and notification integrations used by this app.
# Leave values empty until they are configured in your local or deployment secret store.
REDIS_URL=redis://localhost:6379
GROQ_API_KEY=
GOOGLE_API_KEY=
ATOMESUS_API_KEY=
EMBEDDING_FALLBACK_KEY=
FREE_USER_FALLBACK_KEY=
PRO_USER_FALLBACK_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
SMS_SECRET_HEADER=
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
E2E_ENABLED=false
E2E_API_URL=http://localhost:5000/api
E2E_FRONTEND_URL=http://localhost:3000
