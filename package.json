{
  "name": "ai-study-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "lint": "npm run lint --workspaces",
    "test:backend": "npm test --workspace=backend -- --runInBand",
    "test:e2e": "npm run test:e2e --workspace=frontend",
    "test:load": "k6 run load-tests/k6-chat-upload.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
